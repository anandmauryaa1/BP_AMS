PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/attendance_db?retryWrites=true&w=majority
MONGODB_DB_NAME=attendance_db
AUTH_SECRET=generate_with_openssl_rand_base64_32_minimum_32_chars
CLIENT_URL=http://localhost:3000

# Gmail SMTP Settings (Zero Cost Transactional Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAIL_FROM=Office Attendance <your_email@gmail.com>

# Initial Admin Credentials for Seeding (Production / Setup)
ADMIN_EMPLOYEE_ID=ADM-001
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=System Administrator
