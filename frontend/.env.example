# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/attendance_db?retryWrites=true&w=majority
MONGODB_DB_NAME=attendance_db

# JWT & Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=your_super_secret_key_at_least_32_characters_long

# Gmail SMTP (Zero Cost Email Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
API_PROXY_URL=http://localhost:5000

# Optional Initial Admin Seed (used by setup scripts)
ADMIN_EMPLOYEE_ID=EMP-001
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=System Administrator
